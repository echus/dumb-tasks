// Cloudflare Worker serving the built app as static files, plus the small sign-in helper in
// worker/index.ts. Workers Builds runs `npm run build`; set VITE_GOOGLE_CLIENT_ID as a build
// variable there, and GOOGLE_CLIENT_SECRET as a secret (locally: .dev.vars).
{
  "name": "dumb-tasks",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/auth/*"] },
  // Cloudflare makes the DNS record and certificate. www redirects here via a Redirect Rule.
  "routes": [{ "pattern": "dumbtasks.app", "custom_domain": true }]
}
