// Cloudflare Worker serving the built app as static files, plus the small sign-in helper in
// worker/index.ts. Workers Builds runs `npm run build`; set VITE_GOOGLE_CLIENT_ID as a build
// variable there, and GOOGLE_CLIENT_SECRET as a secret (locally: .dev.vars).
{
  "name": "dumb-tasks",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/auth/*"] },
  // Cloudflare makes the DNS records and certificates. www redirects here via a Redirect Rule.
  // Previews get <name>.dumbtasks.app. Workers Builds deploys each push to a branch other than
  // main as the Preview "staging" (Preview command: `npx wrangler preview --name staging`), so
  // the latest build is at staging.dumbtasks.app.
  "routes": [{ "pattern": "dumbtasks.app", "custom_domain": true, "previews_enabled": true }],
  // Required by `wrangler preview`, even empty. Previews don't get production's secrets: set the
  // staging one with `wrangler preview secret put GOOGLE_CLIENT_SECRET --name staging`.
  "previews": {}
}
